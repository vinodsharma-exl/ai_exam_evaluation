{
  "name": "answereval-ai",
  "productName": "AnswerEval AI",
  "version": "0.1.0",
  "description": "Desktop assistant that recommends marks for handwritten answer sheets. The professor always has the final say.",
  "author": "AnswerEval AI",
  "homepage": "https://answereval.local",
  "private": true,
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:ui": "electron-vite build && node scripts/ui-walkthrough.mjs",
    "schemas": "tsx scripts/generate-json-schemas.ts",
    "samples": "tsx scripts/make-samples.ts",
    "icon": "electron scripts/make-icon.cjs",
    "pack": "electron-vite build && electron-builder --win dir --x64",
    "dist": "npm run typecheck && npm test && electron-vite build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "exceljs": "^4.4.0",
    "pdf-lib": "^1.17.1",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.80.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
