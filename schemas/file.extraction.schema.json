{
  "$id": "answereval-ai/file.extraction.schema.json",
  "title": "file.extraction",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "examId": {
      "type": "string",
      "description": "Folder-safe identifier"
    },
    "studentId": {
      "type": "string",
      "description": "Folder-safe identifier"
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "file": {
            "type": "string"
          },
          "source": {
            "type": "object",
            "properties": {
              "uploadIndex": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "pageInUpload": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "uploadIndex",
              "pageInUpload"
            ]
          },
          "rotation": {
            "default": 0,
            "anyOf": [
              {
                "type": "number",
                "const": 0
              },
              {
                "type": "number",
                "const": 90
              },
              {
                "type": "number",
                "const": 180
              },
              {
                "type": "number",
                "const": 270
              }
            ]
          },
          "width": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "height": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "ocr": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "done",
                  "failed",
                  "manual",
                  "blank",
                  "skipped"
                ]
              },
              "by": {
                "default": null,
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "providerId": {
                        "type": "string",
                        "enum": [
                          "gemini",
                          "groq",
                          "openrouter",
                          "mistral",
                          "openai",
                          "anthropic",
                          "custom",
                          "mock"
                        ]
                      },
                      "model": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      }
                    },
                    "required": [
                      "providerId",
                      "model"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "cacheKey": {
                "default": null,
                "type": [
                  "string",
                  "null"
                ]
              },
              "at": {
                "default": null,
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                    "description": "ISO-8601 timestamp"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "error": {
                "default": null,
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "string"
                      },
                      "detail": {
                        "type": "string"
                      },
                      "resumeAt": {
                        "type": "number"
                      },
                      "at": {
                        "type": "string",
                        "format": "date-time",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                        "description": "ISO-8601 timestamp"
                      }
                    },
                    "required": [
                      "code",
                      "at"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "fragments": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "questionNumber": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 24
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "continued": {
                  "type": "boolean"
                },
                "text": {
                  "type": "string",
                  "maxLength": 20000
                },
                "hasDiagram": {
                  "default": false,
                  "type": "boolean"
                },
                "diagramDescription": {
                  "default": "",
                  "type": "string",
                  "maxLength": 2000
                },
                "illegibleCount": {
                  "default": 0,
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "questionNumber",
                "continued",
                "text",
                "confidence"
              ]
            }
          },
          "pageNote": {
            "default": "",
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "index",
          "file",
          "source",
          "width",
          "height",
          "sha256",
          "ocr"
        ]
      }
    },
    "answers": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "questionNumber": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          },
          "pages": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "text": {
            "type": "string",
            "maxLength": 40000
          },
          "hasDiagram": {
            "type": "boolean"
          },
          "diagramDescription": {
            "default": "",
            "type": "string",
            "maxLength": 4000
          },
          "illegibleCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "origin": {
            "type": "string",
            "enum": [
              "ai",
              "manual",
              "ai_edited"
            ]
          },
          "editedAt": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                "description": "ISO-8601 timestamp"
              },
              {
                "type": "null"
              }
            ]
          },
          "textHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "questionNumber",
          "pages",
          "text",
          "hasDiagram",
          "illegibleCount",
          "confidence",
          "origin",
          "textHash"
        ]
      }
    },
    "notAttempted": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 24
      }
    },
    "unassigned": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "text": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "required": [
          "page",
          "text"
        ]
      }
    },
    "unknownQuestionNumbers": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mergedAt": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "description": "ISO-8601 timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "ISO-8601 timestamp"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "ISO-8601 timestamp"
    }
  },
  "required": [
    "schemaVersion",
    "examId",
    "studentId",
    "pages",
    "createdAt",
    "updatedAt"
  ]
}
