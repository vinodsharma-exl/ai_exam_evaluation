{
  "$id": "answereval-ai/file.jobs.schema.json",
  "title": "file.jobs",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "examId": {
      "type": "string",
      "description": "Folder-safe identifier"
    },
    "studentId": {
      "type": "string",
      "description": "Folder-safe identifier"
    },
    "state": {
      "type": "string",
      "enum": [
        "idle",
        "queued",
        "running",
        "waiting_rate_limit",
        "paused",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "pauseReason": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "user",
            "rate_limit_daily",
            "network",
            "auth",
            "app_closed",
            "no_vision_model",
            "error"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "resumeAt": {
      "default": null,
      "type": [
        "number",
        "null"
      ]
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "kind": {
            "type": "string",
            "enum": [
              "render_pages",
              "ocr_pages",
              "merge_answers",
              "evaluate_questions",
              "finalize_totals"
            ]
          },
          "pages": {
            "default": [],
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "questions": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 24
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "done",
              "failed",
              "skipped",
              "superseded"
            ]
          },
          "model": {
            "default": null,
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "providerId": {
                    "type": "string",
                    "enum": [
                      "gemini",
                      "groq",
                      "openrouter",
                      "mistral",
                      "openai",
                      "anthropic",
                      "custom",
                      "mock"
                    ]
                  },
                  "model": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": [
                  "providerId",
                  "model"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "attempts": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "requestsUsed": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "cacheHit": {
            "default": false,
            "type": "boolean"
          },
          "supersededBy": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "default": "plan",
            "type": "string",
            "maxLength": 60
          },
          "bypassCache": {
            "default": false,
            "type": "boolean"
          },
          "lastError": {
            "default": null,
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "detail": {
                    "type": "string"
                  },
                  "resumeAt": {
                    "type": "number"
                  },
                  "at": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                    "description": "ISO-8601 timestamp"
                  }
                },
                "required": [
                  "code",
                  "at"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "startedAt": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                "description": "ISO-8601 timestamp"
              },
              {
                "type": "null"
              }
            ]
          },
          "finishedAt": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                "description": "ISO-8601 timestamp"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "status"
        ]
      }
    },
    "estimate": {
      "default": null,
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "requests": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "minutes": {
              "type": "number",
              "minimum": 0
            },
            "byStage": {
              "type": "object",
              "properties": {
                "ocr": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "evaluation": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "ocr",
                "evaluation"
              ]
            }
          },
          "required": [
            "requests",
            "minutes",
            "byStage"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "ISO-8601 timestamp"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "ISO-8601 timestamp"
    }
  },
  "required": [
    "schemaVersion",
    "examId",
    "studentId",
    "state",
    "tasks",
    "createdAt",
    "updatedAt"
  ]
}
