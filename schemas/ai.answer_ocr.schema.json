{
  "$id": "answereval-ai/ai.answer_ocr.schema.json",
  "title": "ai.answer_ocr",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "blank": {
            "default": false,
            "type": "boolean"
          },
          "fragments": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "q": {
                  "default": null,
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "continued": {
                  "default": false,
                  "type": "boolean"
                },
                "text": {
                  "default": "",
                  "type": "string"
                },
                "diagram": {
                  "default": "",
                  "type": "string"
                },
                "illegible": {
                  "default": 0,
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "confidence": {
                  "default": 0.5,
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          },
          "note": {
            "default": "",
            "type": "string"
          }
        },
        "required": [
          "page"
        ]
      }
    }
  },
  "required": [
    "pages"
  ]
}
