{
  "$id": "answereval-ai/file.studentIndex.schema.json",
  "title": "file.studentIndex",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "builtAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "ISO-8601 timestamp"
    },
    "students": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "searchKey": {
            "type": "string"
          },
          "displayId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "rollNo": {
            "type": "string"
          },
          "exams": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "examId": {
                  "type": "string",
                  "description": "Folder-safe identifier"
                },
                "studentId": {
                  "type": "string",
                  "description": "Folder-safe identifier"
                },
                "examTitle": {
                  "type": "string"
                },
                "examDate": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
                      "description": "YYYY-MM-DD"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "draft",
                    "processing",
                    "paused",
                    "needs_review",
                    "evaluated",
                    "finalized",
                    "failed"
                  ]
                },
                "total": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "maxTotal": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000
                },
                "isFinal": {
                  "type": "boolean"
                },
                "needsReviewCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "updatedAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                  "description": "ISO-8601 timestamp"
                }
              },
              "required": [
                "examId",
                "studentId",
                "examTitle",
                "examDate",
                "status",
                "total",
                "maxTotal",
                "isFinal",
                "needsReviewCount",
                "updatedAt"
              ]
            }
          }
        },
        "required": [
          "searchKey",
          "displayId",
          "name",
          "rollNo",
          "exams"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "builtAt",
    "students"
  ]
}
