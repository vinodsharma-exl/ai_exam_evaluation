{
  "$id": "answereval-ai/ai.evaluation.schema.json",
  "title": "ai.evaluation",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "results": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "minLength": 1
          },
          "criteria": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "awarded": {
                  "default": 0,
                  "type": "number",
                  "minimum": 0
                },
                "comment": {
                  "default": "",
                  "type": "string"
                }
              },
              "required": [
                "id",
                "awarded"
              ]
            }
          },
          "correct": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "missing": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "feedback": {
            "default": "",
            "type": "string"
          },
          "confidence": {
            "default": 0.5,
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "review": {
            "default": false,
            "type": "boolean"
          },
          "reviewReason": {
            "default": "",
            "type": "string"
          }
        },
        "required": [
          "q"
        ]
      }
    }
  },
  "required": [
    "results"
  ]
}
