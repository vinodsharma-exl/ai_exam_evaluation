{
  "$id": "answereval-ai/file.exam.schema.json",
  "title": "file.exam",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "description": "Folder-safe identifier"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "courseCode": {
      "default": "",
      "type": "string",
      "maxLength": 40
    },
    "subject": {
      "default": "",
      "type": "string",
      "maxLength": 120
    },
    "className": {
      "default": "",
      "type": "string",
      "maxLength": 120
    },
    "examDate": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
          "description": "YYYY-MM-DD"
        },
        {
          "type": "null"
        }
      ]
    },
    "evaluatorNotes": {
      "default": "",
      "type": "string",
      "maxLength": 1000
    },
    "sources": {
      "type": "object",
      "properties": {
        "questionPaper": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "pdf",
                    "images",
                    "manual"
                  ]
                },
                "file": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "originalFileNames": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "pageCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "extractedWith": {
                  "default": null,
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "providerId": {
                          "type": "string",
                          "enum": [
                            "gemini",
                            "groq",
                            "openrouter",
                            "mistral",
                            "openai",
                            "anthropic",
                            "custom",
                            "mock"
                          ]
                        },
                        "model": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        }
                      },
                      "required": [
                        "providerId",
                        "model"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "extractedAt": {
                  "default": null,
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                      "description": "ISO-8601 timestamp"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "kind",
                "file",
                "pageCount"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "modelAnswer": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "pdf",
                    "images",
                    "manual"
                  ]
                },
                "file": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "originalFileNames": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "pageCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "extractedWith": {
                  "default": null,
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "providerId": {
                          "type": "string",
                          "enum": [
                            "gemini",
                            "groq",
                            "openrouter",
                            "mistral",
                            "openai",
                            "anthropic",
                            "custom",
                            "mock"
                          ]
                        },
                        "model": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        }
                      },
                      "required": [
                        "providerId",
                        "model"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "extractedAt": {
                  "default": null,
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                      "description": "ISO-8601 timestamp"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "kind",
                "file",
                "pageCount"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "questionPaper",
        "modelAnswer"
      ]
    },
    "questions": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          },
          "number": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          },
          "order": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "text": {
            "type": "string",
            "maxLength": 8000
          },
          "maxMarks": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000
          },
          "type": {
            "type": "string",
            "enum": [
              "theory",
              "numerical",
              "mixed"
            ]
          },
          "modelAnswer": {
            "default": "",
            "type": "string",
            "maxLength": 20000
          },
          "markingPoints": {
            "default": [],
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^p[0-9]{1,3}$"
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "marks": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000
                }
              },
              "required": [
                "id",
                "description",
                "marks"
              ]
            }
          },
          "finalAnswer": {
            "default": "",
            "type": "string",
            "maxLength": 500
          },
          "expectsDiagram": {
            "default": false,
            "type": "boolean"
          },
          "origin": {
            "default": "manual",
            "type": "string",
            "enum": [
              "ai",
              "manual",
              "ai_edited"
            ]
          },
          "extractionConfidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "label",
          "number",
          "order",
          "text",
          "maxMarks",
          "type"
        ]
      }
    },
    "choiceRules": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "questionNumbers": {
            "minItems": 2,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 24
            }
          },
          "countBest": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "description": {
            "default": "",
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "id",
          "questionNumbers",
          "countBest"
        ]
      }
    },
    "totalMarks": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready",
        "archived"
      ]
    },
    "gradingOverrides": {
      "default": {},
      "type": "object",
      "properties": {
        "strictness": {
          "type": "string",
          "enum": [
            "lenient",
            "standard",
            "strict"
          ]
        },
        "allowHalfMarks": {
          "type": "boolean"
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "ISO-8601 timestamp"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "ISO-8601 timestamp"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "title",
    "sources",
    "questions",
    "totalMarks",
    "status",
    "createdAt",
    "updatedAt"
  ]
}
