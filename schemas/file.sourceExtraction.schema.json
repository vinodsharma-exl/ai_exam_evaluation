{
  "$id": "answereval-ai/file.sourceExtraction.schema.json",
  "title": "file.sourceExtraction",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "examId": {
      "type": "string",
      "description": "Folder-safe identifier"
    },
    "documents": {
      "type": "object",
      "properties": {
        "questionPaper": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "pages": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "index": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "file": {
                        "type": "string"
                      },
                      "sha256": {
                        "type": "string"
                      },
                      "text": {
                        "default": "",
                        "type": "string"
                      }
                    },
                    "required": [
                      "index",
                      "file",
                      "sha256"
                    ]
                  }
                },
                "rawOutput": {
                  "anyOf": [
                    {},
                    {
                      "type": "null"
                    }
                  ]
                },
                "cacheKeys": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "pages",
                "rawOutput"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "modelAnswer": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "pages": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "index": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "file": {
                        "type": "string"
                      },
                      "sha256": {
                        "type": "string"
                      },
                      "text": {
                        "default": "",
                        "type": "string"
                      }
                    },
                    "required": [
                      "index",
                      "file",
                      "sha256"
                    ]
                  }
                },
                "rawOutput": {
                  "anyOf": [
                    {},
                    {
                      "type": "null"
                    }
                  ]
                },
                "cacheKeys": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "pages",
                "rawOutput"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "questionPaper",
        "modelAnswer"
      ]
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "ISO-8601 timestamp"
    }
  },
  "required": [
    "schemaVersion",
    "examId",
    "documents",
    "updatedAt"
  ]
}
